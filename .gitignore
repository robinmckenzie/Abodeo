# Local credentials. Never commit these.
.env
.env.*
*.pem
*.key

# Example files hold placeholder names only, never real values.
!.env.example
!.env.*.example

# Dependencies, build output and generated files.
/node_modules/
/build/
/.react-router/
/coverage/

# Vercel's link to the project and its local build output.
/.vercel/
